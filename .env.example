# AdjutantVoice user config — install.ps1 copies this to ~/.adjutantvoice/.env (never overwrites).
# Read by the MCP server from any directory. Restart the server after editing:
#   schtasks /End /TN "AdjutantVoice MCP" && schtasks /Run /TN "AdjutantVoice MCP"
# Real AV_* environment variables override this file.

# Intel Arc GPU. "cpu" works but takes minutes per sentence.
AV_DEVICE=xpu

# float16 | bfloat16 | float32 (float32 is ~3x slower on XPU, no audible gain)
AV_DTYPE=float16

# Decoding steps: 32 = OmniVoice default, 24 ≈ 1.3x faster, 16 ≈ 2x faster, 8 ≈ 4x faster (rougher)
AV_NUM_STEP=24

# Only listen on this machine. If you change AV_MCP_PORT, re-run install.ps1 so
# Claude Code is registered with the new URL.
AV_HOST=127.0.0.1
AV_MCP_PORT=8222

# Stop the model worker process after this many idle seconds, freeing all of its
# ~6.5 GB; the server itself stays at ~0.1 GB. 0 = keep the model loaded forever.
# The first request after an idle stop restarts the worker (~30-35 s).
AV_IDLE_UNLOAD_SECONDS=300
